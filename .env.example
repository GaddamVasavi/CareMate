# Node & App Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://caremate_admin:caremate_secure_pass@localhost:5432/caremate_db?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Authentication & JWT Secrets
JWT_SECRET=super_secure_jwt_access_secret_key_caremate_2026
JWT_REFRESH_SECRET=super_secure_jwt_refresh_secret_key_caremate_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateways (Stripe / Razorpay Demo)
PAYMENT_PROVIDER=stripe
PAYMENT_KEY_ID=pk_test_sample_key_123456789
PAYMENT_KEY_SECRET=sk_test_sample_secret_987654321
PAYMENT_WEBHOOK_SECRET=whsec_sample_webhook_secret

# Email Notification Service (SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=demo_user
EMAIL_PASSWORD=demo_password
EMAIL_FROM="CareMate Healthcare" <noreply@caremate.health>

# Storage Configuration (Cloudinary / S3 Mock)
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12345
UPLOAD_DIR=./uploads

# Security & CORS
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=500
