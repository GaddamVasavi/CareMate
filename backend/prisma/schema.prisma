// CareMate - Healthcare Management System Database Schema
// Database Engine: PostgreSQL with Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  UNKNOWN
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  RESCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  IN_PERSON
  VIDEO_CONSULTATION
  FOLLOW_UP
  EMERGENCY
}

enum LabOrderStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  STRIPE
  RAZORPAY
  CASH
  INSURANCE
  BANK_TRANSFER
}

enum NotificationType {
  APPOINTMENT_BOOKED
  APPOINTMENT_CONFIRMED
  APPOINTMENT_CANCELLED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_REMINDER
  PRESCRIPTION_CREATED
  LAB_ORDER_CREATED
  LAB_RESULT_READY
  INVOICE_GENERATED
  PAYMENT_SUCCESS
  SYSTEM_ALERT
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

// ==========================================
// MODULE 1: AUTHENTICATION & USERS
// ==========================================

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String
  role              UserRole       @default(PATIENT)
  firstName         String
  lastName          String
  phone             String?        @unique
  avatarUrl         String?
  isActive          Boolean        @default(true)
  isEmailVerified   Boolean        @default(false)
  emailVerifyToken  String?
  resetPasswordToken String?
  resetTokenExpiry  DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // 1-to-1 relations
  patient           Patient?
  doctor            Doctor?
  address           Address?

  // 1-to-many relations
  sessions          Session[]
  loginHistories    LoginHistory[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  isRevoked    Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([refreshToken])
}

model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  status    String   // SUCCESS, FAILED
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Address {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  street      String
  city        String
  state       String
  postalCode  String
  country     String   @default("United States")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmergencyContact {
  id           String   @id @default(uuid())
  patientId    String   @unique
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ==========================================
// MODULE 2: PATIENTS & DOCTORS
// ==========================================

model Patient {
  id               String            @id @default(uuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth      DateTime
  gender           Gender
  bloodGroup       BloodGroup        @default(UNKNOWN)
  height           Float?            // in cm
  weight           Float?            // in kg
  insuranceProvider String?
  insurancePolicyNumber String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relations
  emergencyContact EmergencyContact?
  allergies        Allergy[]
  conditions       MedicalCondition[]
  medicalHistories MedicalHistory[]
  appointments     Appointment[]
  medicalRecords   MedicalRecord[]
  prescriptions    Prescription[]
  labOrders        LabOrder[]
  invoices         Invoice[]
  reviews          DoctorReview[]

  @@index([userId])
}

model Allergy {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  allergen    String
  severity    String    // MILD, MODERATE, SEVERE
  reaction    String?
  diagnosedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([patientId])
}

model MedicalCondition {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name        String
  status      String    // ACTIVE, IN_REMISSION, RESOLVED
  diagnosedAt DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([patientId])
}

model MedicalHistory {
  id          String   @id @default(uuid())
  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  condition   String
  surgeries   String?
  familyHistory String?
  notes       String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId])
}

model Specialization {
  id          String                 @id @default(uuid())
  name        String                 @unique
  description String?
  icon        String?
  doctors     DoctorSpecialization[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model Doctor {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber      String                 @unique
  experienceYears    Int                    @default(1)
  qualifications     String                 // e.g. "MD, MBBS, FACS"
  biography          String?                @db.Text
  consultationFee    Float                  @default(50.0)
  clinicName         String?
  clinicAddress      String?
  languages          String[]               @default(["English"])
  isAvailableForTelehealth Boolean          @default(true)
  ratingAverage      Float                  @default(5.0)
  ratingCount        Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  // Relations
  specializations    DoctorSpecialization[]
  availabilities     DoctorAvailability[]
  schedules          DoctorSchedule[]
  leaves             DoctorLeave[]
  appointments       Appointment[]
  medicalRecords     MedicalRecord[]
  prescriptions      Prescription[]
  labOrders          LabOrder[]
  reviews            DoctorReview[]

  @@index([userId])
  @@index([consultationFee])
  @@index([ratingAverage])
}

model DoctorSpecialization {
  doctorId         String
  doctor           Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specializationId String
  specialization   Specialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@id([doctorId, specializationId])
}

model DoctorAvailability {
  id        String    @id @default(uuid())
  doctorId  String
  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime String    // "09:00"
  endTime   String    // "17:00"
  slotDurationMinutes Int @default(30)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([doctorId, dayOfWeek, startTime])
  @@index([doctorId])
}

model DoctorSchedule {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  startTime   String   // "09:00"
  endTime     String   // "17:00"
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
}

model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
}

model DoctorReview {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  rating    Int      // 1 to 5
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, patientId])
  @@index([doctorId])
}

// ==========================================
// MODULE 3: APPOINTMENTS & SCHEDULING
// ==========================================

model Appointment {
  id              String                   @id @default(uuid())
  appointmentNumber String                 @unique
  patientId       String
  patient         Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId        String
  doctor          Doctor                   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date            DateTime                 @db.Date
  startTime       String                   // "10:00"
  endTime         String                   // "10:30"
  type            AppointmentType          @default(IN_PERSON)
  status          AppointmentStatus        @default(REQUESTED)
  reason          String?                  @db.Text
  cancellationReason String?               @db.Text
  telehealthUrl   String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  // Relations
  statusHistory   AppointmentStatusHistory[]
  medicalRecord   MedicalRecord?
  invoice         Invoice?

  @@unique([doctorId, date, startTime])
  @@index([patientId])
  @@index([doctorId])
  @@index([date])
  @@index([status])
}

model AppointmentSlot {
  id          String   @id @default(uuid())
  doctorId    String
  date        DateTime @db.Date
  startTime   String   // "09:00"
  endTime     String   // "09:30"
  isBooked    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date, isBooked])
}

model AppointmentStatusHistory {
  id            String            @id @default(uuid())
  appointmentId String
  appointment   Appointment       @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  status        AppointmentStatus
  note          String?
  changedById   String?
  createdAt     DateTime          @default(now())

  @@index([appointmentId])
}

// ==========================================
// MODULE 4: CLINICAL RECORDS, PRESCRIPTIONS & LAB
// ==========================================

model MedicalRecord {
  id            String            @id @default(uuid())
  recordNumber  String            @unique
  patientId     String
  patient       Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId      String
  doctor        Doctor            @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentId String?           @unique
  appointment   Appointment?      @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  visitDate     DateTime          @default(now())
  symptoms      String            @db.Text
  diagnosisNote String            @db.Text
  treatmentPlan String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Clinical Sub-components
  vitalSigns    VitalSign[]
  diagnoses     Diagnosis[]
  clinicalNotes ClinicalNote[]
  treatments    Treatment[]
  documents     MedicalDocument[]
  prescriptions Prescription[]

  @@index([patientId])
  @@index([doctorId])
  @@index([visitDate])
}

model VitalSign {
  id                 String        @id @default(uuid())
  medicalRecordId    String
  medicalRecord      MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  systolicBP         Int?          // mmHg
  diastolicBP        Int?          // mmHg
  heartRate          Int?          // bpm
  respiratoryRate    Int?          // breaths/min
  temperature        Float?        // Celsius
  oxygenSaturation   Float?        // SpO2 %
  bloodGlucose       Float?        // mg/dL
  recordedAt         DateTime      @default(now())

  @@index([medicalRecordId])
}

model Diagnosis {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  code            String?       // ICD-10 code if applicable
  description     String
  type            String        // PRIMARY, SECONDARY
  createdAt       DateTime      @default(now())

  @@index([medicalRecordId])
}

model ClinicalNote {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  subjective      String?       @db.Text // SOAP Note: Subjective
  objective       String?       @db.Text // SOAP Note: Objective
  assessment      String?       @db.Text // SOAP Note: Assessment
  plan            String?       @db.Text // SOAP Note: Plan
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([medicalRecordId])
}

model Treatment {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  name            String
  description     String?       @db.Text
  startDate       DateTime?
  endDate         DateTime?
  status          String        // ACTIVE, COMPLETED, DISCONTINUED
  createdAt       DateTime      @default(now())

  @@index([medicalRecordId])
}

model MedicalDocument {
  id              String        @id @default(uuid())
  medicalRecordId String
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  title           String
  fileUrl         String
  fileType        String        // application/pdf, image/jpeg, etc.
  fileSize        Int           // bytes
  uploadedAt      DateTime      @default(now())

  @@index([medicalRecordId])
}

model Medicine {
  id                String             @id @default(uuid())
  name              String             @unique
  genericName       String?
  category          String?
  dosageForm        String             // Tablet, Capsule, Syrup, Injection
  strength          String             // 500mg, 10ml, etc.
  manufacturer      String?
  prescriptionItems PrescriptionItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([name])
}

model Prescription {
  id                 String             @id @default(uuid())
  prescriptionNumber String             @unique
  patientId          String
  patient            Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId           String
  doctor             Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medicalRecordId    String?
  medicalRecord      MedicalRecord?     @relation(fields: [medicalRecordId], references: [id], onDelete: SetNull)
  issueDate          DateTime           @default(now())
  validUntil         DateTime?
  notes              String?            @db.Text
  pdfUrl             String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  items              PrescriptionItem[]

  @@index([patientId])
  @@index([doctorId])
  @@index([prescriptionNumber])
}

model PrescriptionItem {
  id             String       @id @default(uuid())
  prescriptionId String
  prescription   Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId     String?
  medicine       Medicine?    @relation(fields: [medicineId], references: [id], onDelete: SetNull)
  medicineName   String       // Cached name in case medicine table item is deleted
  dosage         String       // "1 tablet"
  frequency      String       // "Twice daily after meals"
  duration       String       // "7 days"
  instructions   String?
  createdAt      DateTime     @default(now())

  @@index([prescriptionId])
}

model LabTest {
  id          String         @id @default(uuid())
  code        String         @unique // e.g. "CBC-001"
  name        String
  category    String         // Hematology, Biochemistry, Radiology, etc.
  description String?
  price       Float
  sampleType  String         // Blood, Urine, Saliva, Swab
  normalRange String?
  unit        String?
  orderItems  LabOrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
}

model LabOrder {
  id          String         @id @default(uuid())
  orderNumber String         @unique
  patientId   String
  patient     Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId    String
  doctor      Doctor         @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  status      LabOrderStatus @default(ORDERED)
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  items       LabOrderItem[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

model LabOrderItem {
  id         String     @id @default(uuid())
  labOrderId String
  labOrder   LabOrder   @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  labTestId  String
  labTest    LabTest    @relation(fields: [labTestId], references: [id], onDelete: Cascade)
  result     LabResult?
  createdAt  DateTime   @default(now())

  @@index([labOrderId])
}

model LabResult {
  id             String       @id @default(uuid())
  labOrderItemId String       @unique
  labOrderItem   LabOrderItem @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)
  resultValue    String
  isAbnormal     Boolean      @default(false)
  remarks        String?      @db.Text
  reportFileUrl  String?
  verifiedBy     String?      // Lab technician/pathologist name
  verifiedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([labOrderItemId])
}

// ==========================================
// MODULE 5: BILLING, PAYMENTS & NOTIFICATIONS
// ==========================================

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?       @unique
  appointment   Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  totalAmount   Float
  discountAmount Float        @default(0.0)
  taxAmount     Float         @default(0.0)
  netAmount     Float
  status        InvoiceStatus @default(ISSUED)
  dueDate       DateTime
  paidAt        DateTime?
  pdfUrl        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  items         InvoiceItem[]
  payments      Payment[]

  @@index([patientId])
  @@index([status])
  @@index([invoiceNumber])
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model Payment {
  id              String        @id @default(uuid())
  paymentNumber   String        @unique
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Float
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionRef  String?       @unique
  gatewayResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  refunds         Refund[]

  @@index([invoiceId])
  @@index([status])
}

model Refund {
  id        String   @id @default(uuid())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount    Float
  reason    String
  status    String   // PENDING, PROCESSED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  linkUrl   String?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// ==========================================
// MODULE 6: ADMIN, AUDIT LOGS & SETTINGS
// ==========================================

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   // CREATE, READ, UPDATE, DELETE, LOGIN, EXPORT
  resource     String   // PATIENT_RECORD, PRESCRIPTION, INVOICE, USER
  resourceId   String?
  details      Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([resource])
  @@index([createdAt])
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  category    String   @default("GENERAL") // GENERAL, BILLING, EMAIL, APPOINTMENT
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
}
